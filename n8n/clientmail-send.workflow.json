{
  "name": "ClientMail — Send",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "clientmail-send",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-220, 0],
      "webhookId": "a1b2c3d4-0001-4000-8000-000000000001"
    },
    {
      "parameters": {
        "jsCode": "// ---------------------------------------------------------------\n// PUT YOUR SHARED SECRET HERE. It must match \"webhook_secret\" in\n// ~/.clientmail/config.json. Anyone who learns your webhook URL can\n// send mail from your Gmail account without it.\nconst SECRET = 'REPLACE_WITH_YOUR_SECRET';\n// ---------------------------------------------------------------\n\nconst item = $input.first().json;\nconst body = item.body ?? item;\n\nif (SECRET && SECRET !== 'REPLACE_WITH_YOUR_SECRET' && body.secret !== SECRET) {\n  throw new Error('Unauthorized: webhook secret does not match');\n}\n\n// Connectivity probe from `config_check` — answer without sending anything.\nif (body.probe === true) {\n  return [{ json: { probe: true, ok: true } }];\n}\n\nfor (const field of ['to', 'subject', 'html']) {\n  if (!body[field]) {\n    throw new Error('Missing required field: ' + field);\n  }\n}\n\nreturn [{\n  json: {\n    probe: false,\n    to: String(body.to),\n    cc: String(body.cc || ''),\n    bcc: String(body.bcc || ''),\n    subject: String(body.subject),\n    html: String(body.html),\n    text: String(body.text || ''),\n    fromName: String(body.fromName || ''),\n    replyTo: String(body.replyTo || ''),\n    draftHash: String(body.draftHash || ''),\n  },\n}];"
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "is-probe",
              "leftValue": "={{ $json.probe }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Is probe?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, probe: true }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Respond Probe",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [460, -120]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "={{ $json.html }}",
        "options": {
          "appendAttribution": false,
          "ccList": "={{ $json.cc }}",
          "bccList": "={{ $json.bcc }}",
          "replyTo": "={{ $json.replyTo }}",
          "senderName": "={{ $json.fromName }}"
        }
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Send via Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [460, 100],
      "notes": "Pick your Gmail credential here after import."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, messageId: $json.id || '', threadId: $json.threadId || '' }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Respond Sent",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [700, 100]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Validate", "type": "main", "index": 0 }]]
    },
    "Validate": {
      "main": [[{ "node": "Is probe?", "type": "main", "index": 0 }]]
    },
    "Is probe?": {
      "main": [
        [{ "node": "Respond Probe", "type": "main", "index": 0 }],
        [{ "node": "Send via Gmail", "type": "main", "index": 0 }]
      ]
    },
    "Send via Gmail": {
      "main": [[{ "node": "Respond Sent", "type": "main", "index": 0 }]]
    }
  },
