      },
      "id": "cm000001-0000-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -460,
        0
      ],
      "webhookId": "cm000001-0000-4000-8000-000000000001"
    },
    {
      "parameters": {
        "jsCode": "// ---------------------------------------------------------------\n// PUT YOUR SHARED SECRET HERE. It must match \"webhook_secret\" in\n// ~/.clientmail/config.json. Anyone who learns your webhook URL can\n// send mail from your Gmail account without it.\nconst SECRET = 'REPLACE_WITH_YOUR_SECRET';\n// ---------------------------------------------------------------\n\nconst item = $input.first().json;\nconst body = item.body ?? item;\n\nif (SECRET && SECRET !== 'REPLACE_WITH_YOUR_SECRET' && body.secret !== SECRET) {\n  throw new Error('Unauthorized: webhook secret does not match');\n}\n\n// Connectivity probe from `clientmail check --ping` -- answer without sending.\nif (body.probe === true) {\n  return [{ json: { probe: true, ok: true, hasAttachments: false } }];\n}\n\nfor (const field of ['to', 'subject', 'html']) {\n  if (!body[field]) {\n    throw new Error('Missing required field: ' + field);\n  }\n}\n\n// Turn the base64 attachments from the payload into n8n binary data.\n// The Gmail node reads these by name, comma-separated, from attachmentFields.\nconst binary = {};\nconst names = [];\nconst atts = Array.isArray(body.attachments) ? body.attachments : [];\natts.forEach((a, i) => {\n  const key = 'attachment_' + i;\n  binary[key] = {\n    data: a.data,\n    mimeType: a.mimeType || 'application/octet-stream',\n    fileName: a.fileName || key,\n  };\n  names.push(key);\n});\n\nreturn [{\n  json: {\n    probe: false,\n    hasAttachments: names.length > 0,\n    attachmentFields: names.join(','),\n    attachmentCount: names.length,\n    to: String(body.to),\n    cc: String(body.cc || ''),\n    bcc: String(body.bcc || ''),\n    subject: String(body.subject),\n    html: String(body.html),\n    text: String(body.text || ''),\n    fromName: String(body.fromName || ''),\n    replyTo: String(body.replyTo || ''),\n    draftHash: String(body.draftHash || ''),\n  },\n  binary,\n}];"
      },
